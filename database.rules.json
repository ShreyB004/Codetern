{
  "rules": {
    ".read": false,
    ".write": false,
    "siteContent": {
      ".read": true,
      ".write": "auth != null && auth.token.email == 'shreybhangale@gmail.com'"
    },
    "events": {
      "$sid": {
        ".write": "!data.exists()",
        ".validate": "newData.hasChildren()"
      }
    },
    "joinRequests": {
      ".read": "auth != null && auth.token.email == 'shreybhangale@gmail.com'",
      "$id": {
        ".write": "(!data.exists() && newData.child('status').val() == 'requested') || (auth != null && auth.token.email == 'shreybhangale@gmail.com')",
        ".validate": "newData.hasChildren(['fullName', 'email', 'status']) && newData.child('email').isString() && newData.child('fullName').isString()"
      }
    },
    "contacts": {
      ".read": "auth != null && auth.token.email == 'shreybhangale@gmail.com'",
      "$id": {
        ".write": "(!data.exists() && newData.child('status').val() == 'new') || (auth != null && auth.token.email == 'shreybhangale@gmail.com')"
      }
    },
    "leads": {
      ".read": "auth != null && auth.token.email == 'shreybhangale@gmail.com'",
      ".write": "auth != null && auth.token.email == 'shreybhangale@gmail.com'"
    },
    "users": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && (auth.uid == $uid || auth.token.email == 'shreybhangale@gmail.com')"
      }
    },
    "enrollments": {
      ".read": "auth != null",
      "$id": {
        ".write": "auth != null && (auth.token.email == 'shreybhangale@gmail.com' || (newData.child('email').val() == auth.token.email && newData.child('uid').val() == auth.uid && data.child('email').val() == auth.token.email))"
      }
    },
    "tasks": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.email == 'shreybhangale@gmail.com'"
    },
    "attendance": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.email == 'shreybhangale@gmail.com'"
    },
    "attendanceByStudent": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.email == 'shreybhangale@gmail.com'"
    },
    "fees": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.email == 'shreybhangale@gmail.com'"
    },
    "taskState": {
      ".read": "auth != null",
      "$task": {
        "$u": {
          ".write": "auth != null && (auth.token.email == 'shreybhangale@gmail.com' || (auth.uid == $u && (!data.exists() || data.child('status').val() != 'completed') && (newData.child('status').val() == 'in-progress' || newData.child('status').val() == 'submitted')))"
        }
      }
    },
    "taskSubmissions": {
      ".read": "auth != null",
      "$task": {
        "$id": {
          ".write": "auth != null && ((!data.exists() && newData.child('uid').val() == auth.uid) || auth.token.email == 'shreybhangale@gmail.com')"
        }
      }
    },
    "progress": {
      ".read": "auth != null",
      "$u": {
        ".write": "auth != null && (auth.uid == $u || auth.token.email == 'shreybhangale@gmail.com')"
      }
    },
    "reviews": {
      ".read": "auth != null",
      "$id": {
        ".write": "auth != null && ((!data.exists() && newData.child('status').val() == 'pending' && newData.child('uid').val() == auth.uid) || auth.token.email == 'shreybhangale@gmail.com')"
      }
    },
    "messages": {
      ".read": "auth != null",
      "$scope": {
        "$id": {
          ".write": "auth != null && (!data.exists() || auth.token.email == 'shreybhangale@gmail.com' || data.child('uid').val() == auth.uid)",
          ".validate": "!newData.exists() || (newData.child('text').isString() && newData.child('text').val().length <= 800)"
        }
      }
    },
    "mentorChats": {
      ".read": "auth != null",
      "$student": {
        "$id": {
          ".write": "auth != null && (!data.exists() || auth.token.email == 'shreybhangale@gmail.com' || data.child('uid').val() == auth.uid)",
          ".validate": "!newData.exists() || (newData.child('text').isString() && newData.child('text').val().length <= 800)"
        }
      }
    }
  }
}
